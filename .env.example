# ---- Django ----
DEBUG=True
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-50-ky-tu
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
LOG_JSON=False

# ---- MySQL 8.0 ----
DB_ENGINE=mysql
DB_NAME=social_db
DB_USER=social_user
DB_PASSWORD=social_pass123
DB_ROOT_PASSWORD=root_pass123
DB_HOST=db
DB_PORT=3306

# ---- Redis 7 (db0: cache/OTP/presence, db1: Celery broker, db2: Channel Layer) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2

# ---- JWT ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- Object Storage: MinIO (local) / Cloudflare R2 (production) ----
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=social-media
S3_REGION=us-east-1
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/social-media
MAX_UPLOAD_MB=10

# ---- Email OTP qua Resend (để trống = in mã OTP ra log của worker) ----
RESEND_API_KEY=
EMAIL_FROM=MiniSocial <onboarding@resend.dev>
APP_NAME=MiniSocial

# ---- Giám sát lỗi Sentry (để trống = tắt) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
