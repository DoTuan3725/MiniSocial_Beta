# =====================================================================
# BIẾN MÔI TRƯỜNG PRODUCTION (đặt tại /opt/minisocial/.env trên VPS, quyền 600)
# =====================================================================
IMAGE_TAG=latest
GHCR_IMAGE=ghcr.io/<github-org>/minisocial-backend

DEBUG=False
SECRET_KEY=<chuoi-ngau-nhien-64-ky-tu>
ALLOWED_HOSTS=api.yourdomain.vn,backend
CORS_ALLOWED_ORIGINS=https://yourdomain.vn,https://www.yourdomain.vn
REFRESH_COOKIE_SAMESITE=Strict
LOG_JSON=True

DB_ENGINE=mysql
DB_NAME=social_db
DB_USER=social_user
DB_PASSWORD=<mat-khau-manh>
DB_ROOT_PASSWORD=<mat-khau-root-manh>
DB_HOST=db
DB_PORT=3306

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2

# Cloudflare R2: Dashboard > R2 > Manage API Tokens (quyền Object Read & Write cho bucket)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<r2-access-key-id>
S3_SECRET_KEY=<r2-secret-access-key>
S3_BUCKET=minisocial-media
S3_REGION=auto
# Custom domain gắn vào bucket R2 (Settings > Public access > Custom domain)
MEDIA_PUBLIC_BASE_URL=https://media.yourdomain.vn

RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=MiniSocial <no-reply@yourdomain.vn>
APP_NAME=MiniSocial

SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
SENTRY_ENVIRONMENT=production

# Sao lưu CSDL
BACKUP_KEEP_DAYS=14
